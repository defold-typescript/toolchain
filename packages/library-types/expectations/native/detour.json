{
  "registry": {
    "sourceId": "defold-detour",
    "manifestDir": "detour"
  },
  "resolve": {
    "archiveUrl": "https://github.com/abadonna/defold-detour/archive/95ce965cb404cecfacd5ba1fc8115a6bb7341a85.zip",
    "confirmedManifest": "defold-detour-95ce965cb404cecfacd5ba1fc8115a6bb7341a85/detour/ext.manifest",
    "misplacedManifest": "defold-detour-95ce965cb404cecfacd5ba1fc8115a6bb7341a85/ext.manifest"
  },
  "receiverEmit": {
    "reason": "Every NavMesh and Crowd method reads its table's `instance` handle from stack slot 1, so a dot call raises a bad-argument error or reads the wrong slot; only TSTL's emit shows which call form the shipped declaration produces.",
    "consumer": [
      "import * as detour from \"detour\";",
      "export function navigate(data: string): number {",
      "  const mesh = detour.init(data);",
      "  const from = vmath.vector3(0, 0, 0);",
      "  const to = vmath.vector3(10, 0, 10);",
      "  const path = mesh.find_path(from, to);",
      "  const crowd = mesh.create_crowd(0.6);",
      "  const agent = crowd.add_agent(from, 0.6, 2, 8, 3.5, 0);",
      "  crowd.set_target(to, agent);",
      "  const agents = crowd.update(1 / 60);",
      "  mesh.delete();",
      "  const first = path.get(0);",
      "  return first === undefined ? 0 : (agents.get(agent)?.position.x ?? first.area);",
      "}"
    ]
  },
  "pinKind": "commit",
  "page": {
    "shapes": {
      "NavMesh": ["NavMesh.find_path"],
      "Crowd": ["Crowd.update"]
    }
  }
}
