{
  "registry": {
    "sourceId": "defold-box2d",
    "manifestDir": "box2d/native"
  },
  "resolve": {
    "archiveUrl": "https://github.com/d954mas/defold-box2d/archive/refs/tags/1.0.3.zip",
    "confirmedManifest": "defold-box2d-1.0.3/box2d/native/ext.manifest",
    "misplacedManifest": "defold-box2d-1.0.3/box2d/ext.manifest"
  },
  "receiverEmit": {
    "reason": "Every box2d userdata method reads its object from stack slot 1, and the extension calls each listener and ray-cast callback with only its own arguments; only TSTL's emit shows which call form and which callback parameters the shipped declaration produces.",
    "consumer": [
      "export function simulate(): number {",
      "  const world = box2d.NewWorld(vmath.vector3(0, -10, 0));",
      "  const body = world.CreateBody({ type: box2d.b2BodyType.b2_dynamicBody });",
      "  const shape = box2d.NewCircleShape();",
      "  shape.SetRadius(0.5);",
      "  body.CreateFixture(shape, 1);",
      "  world.SetContactListener({",
      "    BeginContact: (contact) => {",
      "      contact.SetEnabled(false);",
      "    },",
      "  });",
      "  let hits = 0;",
      "  world.RayCast(",
      "    (fixture, point, normal, fraction) => {",
      "      hits += 1;",
      "      return fraction;",
      "    },",
      "    vmath.vector3(-5, 0, 0),",
      "    vmath.vector3(5, 0, 0),",
      "  );",
      "  world.Step(1 / 60, 8, 3);",
      "  return hits;",
      "}"
    ]
  },
  "page": {
    "shapes": {
      "Body": ["Body.CreateFixture"]
    },
    "symbols": ["b2BodyType.b2_dynamicBody"]
  }
}
