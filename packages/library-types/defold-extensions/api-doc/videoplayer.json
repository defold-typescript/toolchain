      "name": "videoplayer.stop",
      "description": "Stop playback without removing the video view or emitting VIDEO_EVENT_FINISHED. Call destroy to skip and remove the video.",
      "parameters": [
        {
          "name": "handle",
          "doc": "",
          "types": [
            "number"
          ]
        }
      ],
      "returnvalues": []
    },
    {
      "type": "FUNCTION",
      "name": "videoplayer.pause",
      "description": "Pause playback.",
      "parameters": [
        {
          "name": "handle",
          "doc": "",
          "types": [
            "number"
          ]
        }
      ],
      "returnvalues": []
    },
    {
      "type": "FUNCTION",
      "name": "videoplayer.set_visible",
      "description": "Show or hide the video view.",
      "parameters": [
        {
          "name": "handle",
          "doc": "",
          "types": [
            "number"
          ]
        },
        {
          "name": "visible",
          "doc": "",
          "types": [
            "boolean"
          ]
        }
      ],
      "returnvalues": []
    },
    {
      "type": "CONSTANT",
      "name": "videoplayer.VIDEO_EVENT_READY",
      "brief": "Video is prepared; data contains width/height.",
      "description": "Video is prepared; data contains width/height."
    },
    {
      "type": "CONSTANT",
      "name": "videoplayer.VIDEO_EVENT_FINISHED",
      "brief": "Playback finished.",
      "description": "Playback finished."
    },
    {
      "type": "CONSTANT",
      "name": "videoplayer.VIDEO_EVENT_FAILED",
      "brief": "Prepare/playback failed.",
