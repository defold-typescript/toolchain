    {
      "type": "FUNCTION",
      "name": "fusion.spawn",
      "description": "Create a networked game object. This will spawn a game object in the same.\nWay as when calling factory.create(). The function will also register the spawned object with Fusion as if manually calling register_object()\n",
      "parameters": [
        {
          "name": "factory_url",
          "doc": "",
          "types": [
            "string"
          ]
        },
        {
          "name": "position",
          "doc": "Initial position of created game object\n",
          "types": [
            "vector3"
          ],
          "is_optional": "True"
        },
        {
          "name": "rotation",
          "doc": "Initial rotation of created game object\n",
          "types": [
            "quat"
          ],
          "is_optional": "True"
        },
        {
          "name": "map",
          "doc": "The map to which this object belongs\n",
          "types": [
            "number"
          ]
        },
        {
          "name": "owner_mode",
          "doc": "Owner mode of spawned object\n",
          "types": [
            "number"
          ]
        },
        {
          "name": "options",
          "doc": "Table with `properties` and `replication_mode` fields. The\nproperties field should be a id,property map with script ids and properties to\nsync. Replication mode should be one of the established `REPLICATION_MODE`\nconstants.\n",
          "types": [
            "table"
