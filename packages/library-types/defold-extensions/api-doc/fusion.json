          "name": "target_player",
          "doc": "0 = all, specific PlayerId = targeted\n",
          "types": [
            "number"
          ]
        },
        {
          "name": "target_object",
          "doc": "Id of game object, nil for broadcast\n",
          "types": [
            "hash"
          ]
        },
        {
          "name": "event",
          "doc": "",
          "types": [
            "hash"
          ]
        },
        {
          "name": "data",
