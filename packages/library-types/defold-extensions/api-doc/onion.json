    {
      "type": "FUNCTION",
      "name": "onion.play_animation",
      "description": "Plays the specified animation on a Onion model.",
      "parameters": [
        {
          "name": "url",
          "doc": "The Onion model.",
          "types": [
            "string",
            "hash",
            "url"
          ]
        },
        {
          "name": "animation_id",
          "doc": "Id of the animation to play.",
          "types": [
            "string",
            "hash"
          ]
        },
        {
          "name": "playback",
          "doc": "Playback mode of the animation (available go.PLAYBACK_ONCE_FORWARD, go.PLAYBACK_LOOP_FORWARD).",
          "types": [
            "number"
          ]
        },
        {
          "name": "options",
          "doc": "Playback options.",
          "types": [
            "table"
          ]
        },
        {
          "name": "callback_function",
          "doc": "function to call when the animation has completed or a Onion event occured.",
          "types": [
            "function"
          ]
        }
      ],
      "returnvalues": []
    },
