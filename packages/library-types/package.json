{
  "name": "@defold-typescript/library-types",
  "version": "0.0.0",
  "description": "Vendored TypeScript types for popular Defold Lua libraries, core-type-renamed against @defold-typescript/types.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defold-typescript/toolchain.git",
    "directory": "packages/library-types"
  },
  "homepage": "https://github.com/defold-typescript/toolchain#readme",
  "bugs": "https://github.com/defold-typescript/toolchain/issues",
  "type": "module",
  "exports": {
    "./monarch.monarch": {
      "types": "./generated/monarch.monarch.d.ts"
    },
    "./monarch.transitions.easings": {
      "types": "./generated/monarch.transitions.easings.d.ts"
    },
    "./monarch.transitions.gui": {
      "types": "./generated/monarch.transitions.gui.d.ts"
    },
    "./in.accelerometer": {
      "types": "./generated/in.accelerometer.d.ts"
    },
    "./in.button": {
      "types": "./generated/in.button.d.ts"
    },
    "./in.cursor": {
      "types": "./generated/in.cursor.d.ts"
    },
    "./in.gesture": {
      "types": "./generated/in.gesture.d.ts"
    },
    "./in.keyboard": {
      "types": "./generated/in.keyboard.d.ts"
    },
    "./in.mapper": {
      "types": "./generated/in.mapper.d.ts"
    },
    "./in.onscreen": {
      "types": "./generated/in.onscreen.d.ts"
    },
    "./in.state": {
      "types": "./generated/in.state.d.ts"
    },
    "./in.textbox": {
      "types": "./generated/in.textbox.d.ts"
    },
    "./in.triggers": {
      "types": "./generated/in.triggers.d.ts"
    },
    "./metrics.fps": {
      "types": "./generated/metrics.fps.d.ts"
    },
    "./metrics.mem": {
      "types": "./generated/metrics.mem.d.ts"
    },
    "./richtext.color": {
      "types": "./generated/richtext.color.d.ts"
    },
    "./richtext.richtext": {
      "types": "./generated/richtext.richtext.d.ts"
    },
    "./richtext.tags": {
      "types": "./generated/richtext.tags.d.ts"
    },
    "./package.json": "./package.json",
    "./bridge.bridge": {
      "types": "./generated/bridge.d.ts"
    }
  },
  "files": [
    "generated",
    "api-doc",
    "library-targets.json",
    "library-classification.json",
    "luals-targets.json",
    "script-api-targets.json",
    "authored-targets.json",
    "openapi-targets.json",
    "native-targets.json",
    "defold-extensions.json",
    "index-slot-classifications.json",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "regen": "bun ../cli/src/library/sync-library-types.ts",
    "check": "bun ../cli/src/library/sync-library-types.ts --check",
    "classify": "bun ../cli/src/library/sync-library-types.ts --classify",
    "luals:fetch": "bun ../cli/src/library/sync-luals-types.ts --fetch",
    "luals:fidelity": "bun ../cli/src/library/sync-luals-types.ts --fidelity",
    "luals:emit": "bun ../cli/src/library/sync-luals-types.ts --emit",
    "luals:api-doc": "bun ../cli/src/library/sync-luals-types.ts --api-doc",
    "native:api-doc": "bun ../cli/src/library/sync-native-types.ts --api-doc",
    "asset-portal:sync": "bun ../cli/src/library/sync-asset-portal.ts --fetch",
    "fidelity:floor": "bun ../cli/src/library/fidelity-floor.ts --raise",
    "parity": "bun ../cli/src/library/authored-parity.ts && bun ../cli/src/library/native-parity.ts"
  },
  "dependencies": {
    "@defold-typescript/types": "workspace:*"
  },
  "devDependencies": {
    "@typescript-to-lua/language-extensions": "1.19.0",
    "typescript": "6.0.2"
  }
}
