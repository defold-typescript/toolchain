{
  "name": "@defold-typescript/library-types",
  "version": "0.0.0",
  "private": true,
  "description": "Vendored TypeScript types for popular Defold Lua libraries, core-type-renamed against @defold-typescript/types.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defold-typescript/toolchain.git",
    "directory": "packages/library-types"
  },
  "homepage": "https://github.com/defold-typescript/toolchain#readme",
  "bugs": "https://github.com/defold-typescript/toolchain/issues",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "regen": "bun ../cli/src/library/sync-library-types.ts --data data",
    "check": "bun ../cli/src/library/sync-library-types.ts --check --data data",
    "classify": "bun ../cli/src/library/sync-library-types.ts --classify --data data",
    "luals:fetch": "bun ../cli/src/library/sync-luals-types.ts --fetch --data data",
    "luals:fidelity": "bun ../cli/src/library/sync-luals-types.ts --fidelity --data data",
    "api-doc": "bun ../cli/src/bin.ts library check --data data --api-doc-out api-doc",
    "asset-portal:sync": "bun ../cli/src/library/sync-asset-portal.ts --fetch --data data",
    "fidelity:floor": "bun ../cli/src/library/fidelity-floor.ts --raise --data data",
    "parity": "bun ../cli/src/library/authored-parity.ts --data data && bun ../cli/src/library/native-parity.ts --data data"
  },
  "dependencies": {
    "@defold-typescript/types": "workspace:*"
  },
  "devDependencies": {
    "@typescript-to-lua/language-extensions": "1.19.0",
    "typescript": "6.0.2"
  }
}
