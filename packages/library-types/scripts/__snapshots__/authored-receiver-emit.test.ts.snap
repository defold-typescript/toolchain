local ____exports = {}
local BehaviorTree = require("def_behavior_tree.behavior_tree")
function ____exports.init(ship, id)
    BehaviorTree.registerTemplates({TREES = {SHIP = {main_node = {
        type = BehaviorTree.Task,
        run = function(task) return task.success() end
    }}}})
    local tree = BehaviorTree.new({tree_name = "SHIP", payload = ship})
    tree:run()
    tree:restart(id)
end
return ____exports
"
`;

