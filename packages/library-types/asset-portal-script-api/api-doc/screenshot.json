{
  "info": {
    "namespace": "screenshot",
    "brief": "Functions for capturing full-screen or partial screenshots.",
    "description": "Functions for capturing full-screen or partial screenshots."
  },
  "elements": [
    {
      "type": "FUNCTION",
      "name": "screenshot.png",
      "description": "Capture a screenshot as PNG-encoded bytes. On native platforms this is synchronous unless a callback is provided. On HTML5, only the asynchronous callback form is supported.",
      "parameters": [
        {
          "name": "x",
          "doc": "X coordinate (lower-left) for partial capture.",
          "types": [
            "number"
          ],
          "is_optional": "True"
        },
        {
          "name": "y",
          "doc": "Y coordinate (lower-left) for partial capture.",
          "types": [
            "number"
          ],
          "is_optional": "True"
        },
        {
          "name": "w",
          "doc": "Width for partial capture.",
          "types": [
            "number"
          ],
          "is_optional": "True"
        },
        {
          "name": "h",
          "doc": "Height for partial capture.",
          "types": [
            "number"
          ],
          "is_optional": "True"
        },
        {
          "name": "callback",
          "doc": "Called on post-render (or next frame on HTML5) with the PNG bytes.",
          "types": [
            "function"
          ],
          "fields": [
            {
              "name": "self",
              "doc": "The calling script instance.",
              "types": [
                "object"
              ]
            },
            {
              "name": "image",
              "doc": "PNG data as a Lua string.",
              "types": [
                "string"
              ]
            },
            {
              "name": "width",
              "doc": "Image width in pixels.",
              "types": [
                "number"
              ]
            },
            {
              "name": "height",
              "doc": "Image height in pixels.",
              "types": [
                "number"
              ]
            }
          ],
          "is_optional": "True"
        }
      ],
      "returnvalues": [
        {
          "name": "image",
          "doc": "PNG data as a Lua string (native only, synchronous form).",
          "types": [
            "string"
          ]
        },
        {
          "name": "width",
          "doc": "",
          "types": [
            "number"
          ]
        },
        {
          "name": "height",
          "doc": "",
          "types": [
            "number"
          ]
        }
      ],
      "examples": "<div class=\"codehilite\"><pre><code class=\"language-lua\">-- fullscreen with callback\nscreenshot.png(function(self, image, w, h)\n    -- do something with image\nend)\n\n-- partial with callback\nscreenshot.png(0, 0, 100, 200, function(self, image, w, h)\n    -- do something with image\nend)\n\n-- fullscreen (native only)\nlocal image, w, h = screenshot.png()</code></pre></div>"
    },
    {
