      "examples": "<div class=\"codehilite\"><pre><code class=\"language-lua\">local buffer, w, h = screenshot.buffer()\nresource.set_texture(go.get(\"cube#model\", \"texture0\"), {\n    type = resource.TEXTURE_TYPE_2D,\n    width = w,\n    height = h,\n    format = resource.TEXTURE_FORMAT_RGBA\n}, buffer)</code></pre></div>"
