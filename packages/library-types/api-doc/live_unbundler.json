    {
      "type": "FUNCTION",
      "name": "get_modules_download_progress",
      "brief": "Byte-based progress for a module or a set of modules, with a per-resolution\nbreakdown in the low/high fields. Shared dependency archives are counted once\nper set; an archive identical in both manifests counts toward the resolution\ncounted first (for RES_BOTH that is lowres — the pass that actually downloads\nit). Anchored to the download queue: an archive counts as downloaded when\nnothing for it is pending, so the result reaches 100 exactly when the set's\ndownloads drain. For by_request modules that were not requested yet, the\nfuture queue content is predicted from the same rules enqueue_modules uses;\nthat prediction can dip for a moment while a shared archive is remounted to\nits highres copy, it recovers on the next mount.",
      "description": "Byte-based progress for a module or a set of modules, with a per-resolution\nbreakdown in the low/high fields. Shared dependency archives are counted once\nper set; an archive identical in both manifests counts toward the resolution\ncounted first (for RES_BOTH that is lowres — the pass that actually downloads\nit). Anchored to the download queue: an archive counts as downloaded when\nnothing for it is pending, so the result reaches 100 exactly when the set's\ndownloads drain. For by_request modules that were not requested yet, the\nfuture queue content is predicted from the same rules enqueue_modules uses;\nthat prediction can dip for a moment while a shared archive is remounted to\nits highres copy, it recovers on the next mount.",
      "parameters": [
        {
          "name": "module_names",
          "doc": "",
          "types": [
            "string | string[]"
          ],
          "is_optional": "False",
          "is_vararg": "False"
        }
      ],
      "returnvalues": [
        {
          "name": "",
          "doc": "",
          "types": [
            "liveupdater_download_progress"
          ]
        }
      ]
    },
