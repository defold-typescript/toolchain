    {
      "type": "FUNCTION",
      "name": "init",
      "brief": "Loads proto files from the specified paths in the game.project\nUnder the \"proto.proto_paths\" key in the game.project",
      "description": "Loads proto files from the specified paths in the game.project\nUnder the \"proto.proto_paths\" key in the game.project",
      "parameters": [
        {
          "name": "proto_config_or_path",
          "doc": "Lua table or path to proto list config. Example: \"/resources/proto.json\"",
          "types": [
            "LuaTable | string"
          ],
          "is_optional": "False",
          "is_vararg": "False"
        }
      ],
      "returnvalues": []
    },
    {
