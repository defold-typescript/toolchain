          ]
        }
      ]
    },
    {
      "type": "FUNCTION",
      "name": "decode",
      "brief": "Decode bytes to lua table",
      "description": "Decode bytes to lua table",
      "parameters": [
        {
          "name": "proto_type",
          "doc": "@The full proto message name (e.g. \"game.data\", where game is package and data is message name)",
