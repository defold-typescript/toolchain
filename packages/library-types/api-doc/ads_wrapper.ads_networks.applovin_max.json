    {
      "type": "FUNCTION",
      "name": "set_banner_position",
      "brief": "Sets banner position. It is imperative to hide and show the banner again after this function.\nPossible positions:\n`applovin_max.POS_TOP_CENTER`(default)\n`applovin_max.POS_BOTTOM_CENTER`\n`applovin_max.POS_BOTTOM_LEFT`\n`applovin_max.POS_BOTTOM_RIGHT`\n`applovin_max.POS_NONE`\n`applovin_max.POS_TOP_LEFT`\n`applovin_max.POS_TOP_RIGHT`\n`applovin_max.POS_CENTER`",
      "description": "Sets banner position. It is imperative to hide and show the banner again after this function.\nPossible positions:\n`applovin_max.POS_TOP_CENTER`(default)\n`applovin_max.POS_BOTTOM_CENTER`\n`applovin_max.POS_BOTTOM_LEFT`\n`applovin_max.POS_BOTTOM_RIGHT`\n`applovin_max.POS_NONE`\n`applovin_max.POS_TOP_LEFT`\n`applovin_max.POS_TOP_RIGHT`\n`applovin_max.POS_CENTER`",
      "parameters": [
        {
          "name": "position",
          "doc": "banner position",
          "types": [
            "string"
          ],
          "is_optional": "False",
          "is_vararg": "False"
        }
