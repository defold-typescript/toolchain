{
  "luals": [
    {
      "sourceGlobs": ["narrator/annotations.lua", "narrator/narrator.lua", "narrator/story.lua"],
      "moduleId": "narrator.narrator",
      "namespace": "narrator",
      "typeRenames": {},
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"],
      "annotationOverrides": {
        "moduleFunctions": {
          "parse_content": {
            "params": {
              "inclusions": {
                "optional": true
              }
            }
          }
        },
        "interfaces": {
          "Narrator.Story": {
            "methods": {
              "continue": {
                "return": "Narrator.Paragraph[]|Narrator.Paragraph"
              },
              "observe": {
                "params": {
                  "observer": {
                    "type": "fun(value: any)"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
