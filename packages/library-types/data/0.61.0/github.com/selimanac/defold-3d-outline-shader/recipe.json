{
  "luals": [
    {
      "sourceGlobs": ["outline-shader/**/*.lua"],
      "moduleId": "outline-shader.outline",
      "namespace": "outline",
      "typeRenames": {
        "matrix4": "Matrix4",
        "vector4": "Vector4"
      },
      "ignore": [],
      "annotationOverrides": {
        "moduleFunctions": {
          "init": {
            "params": {
              "self": {
                "type": "table<string, any>",
                "optional": false,
                "evidence": {
                  "file": "outline-shader/outline.lua",
                  "contains": "self.outline_constant_buffer = render.constant_buffer()"
                }
              }
            }
          },
          "update": {
            "params": {
              "self": {
                "type": "table<string, any>",
                "optional": false,
                "evidence": {
                  "file": "outline-shader/outline.lua",
                  "contains": "self.outline_constant_buffer.outline_color = outline_color"
                }
              },
              "predicates": {
                "type": "table<string, any>",
                "optional": false,
                "evidence": {
                  "file": "outline-shader/outline.lua",
                  "contains": "render.draw(predicates.outline, { frustum = frustum.frustum })"
                }
              },
              "frustum": {
                "type": "{ frustum: matrix4 }",
                "optional": false,
                "evidence": {
                  "file": "outline-shader/outline.lua",
                  "contains": "render.draw(predicates.outline, { frustum = frustum.frustum })"
                }
              },
              "clear_buffer": {
                "type": "any",
                "evidence": {
                  "file": "outline-shader/outline.lua",
                  "contains": "function outline.update(self, predicates, frustum, clear_buffer)"
                }
              }
            }
          }
        },
        "moduleConstants": {
          "type": {
            "type": "{ OUTLINE_STENCIL: integer, OUTLINE_INVERTED_HULL: integer }",
            "evidence": {
              "file": "outline-shader/outline.lua",
              "contains": "outline.type = { OUTLINE_STENCIL = 1, OUTLINE_INVERTED_HULL = 2 }"
            }
          }
        }
      }
    }
  ]
}
