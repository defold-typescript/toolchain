{
  "luals": [
    {
      "sourceGlobs": ["log/**/*.lua"],
      "moduleId": "log.log",
      "namespace": "log",
      "typeRenames": {
        "debuginfo": "debug.FunctionInfo"
      },
      "annotationOverrides": {
        "interfaces": {
          "log": {
            "callSignature": {
              "drop": true,
              "evidence": {
                "file": "log/log.lua",
                "contains": "---@overload fun(name: string?, force_logger_level_in_debug: string?): logger"
              }
            }
          }
        }
      },
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"]
    }
  ]
}
