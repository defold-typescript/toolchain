{
  "luals": [
    {
      "sourceGlobs": ["narrator/annotations.lua", "narrator/narrator.lua", "narrator/story.lua"],
      "moduleId": "narrator.narrator",
      "namespace": "narrator",
      "typeRenames": {},
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"],
      "annotationOverrides": {
        "moduleFunctions": {
          "parse_content": {
            "params": {
              "inclusions": {
                "optional": true,
                "evidence": {
                  "file": "narrator/narrator.lua",
                  "contains": "local inclusions = inclusions or { }"
                }
              }
            }
          }
        },
        "interfaces": {
          "Narrator.Story": {
            "methods": {
              "continue": {
                "return": "Narrator.Paragraph[]|Narrator.Paragraph",
                "evidence": {
                  "file": "narrator/story.lua",
                  "contains": "return single_mode and lines[1] or lines"
                }
              },
              "observe": {
                "params": {
                  "observer": {
                    "type": "fun(value: any)",
                    "evidence": {
                      "file": "narrator/story.lua",
                      "contains": "---@param observer fun(variable)"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
