          "doc": "Random value.",
          "types": [
            "number"
          ]
        }
      ]
    },
    {
      "type": "FUNCTION",
      "name": "pcgrandom.advance",
      "description": "Advances the generator forward delta steps, but does so in logarithmic time. (Not available for non-equidistributed extended generators.)",
      "parameters": [
        {
          "name": "rng",
          "doc": "RNG instance.",
          "types": [
            "lightuserdata"
          ]
        },
        {
          "name": "delta",
          "doc": "Delta.",
          "types": [
            "number"
          ]
        }
      ],
      "returnvalues": []
    },
    {
      "type": "FUNCTION",
      "name": "pcgrandom.backstep",
      "description": "Moves the generator backwards delta steps, but does so in logarithmic time. (Not available for non-equidistributed extended generators.)",
      "parameters": [
        {
          "name": "rng",
          "doc": "RNG instance.",
          "types": [
            "lightuserdata"
          ]
        },
        {
          "name": "delta",
          "doc": "Delta.",
          "types": [
            "number"
          ]
        }
      ],
      "returnvalues": []
    },
    {
      "type": "FUNCTION",
      "name": "pcgrandom.max",
      "description": "Returns the greatest possible random value from the generator.",
      "parameters": [
        {
          "name": "rng",
          "doc": "RNG instance.",
          "types": [
            "lightuserdata"
          ]
        }
      ],
