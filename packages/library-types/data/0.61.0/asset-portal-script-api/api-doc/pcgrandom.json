          "types": [
            "number"
          ]
        }
      ]
    },
    {
      "type": "FUNCTION",
      "name": "pcgrandom.period_pow2",
      "description": "Returns the period of the generator as a power of two. For PCG32, it returns 64, indicating a period of 2^64.",
      "parameters": [
        {
          "name": "rng",
          "doc": "RNG instance.",
          "types": [
            "lightuserdata"
          ]
        }
      ],
      "returnvalues": [
        {
          "name": "period",
          "doc": "Period.",
          "types": [
            "number"
          ]
        }
      ]
    },
    {
      "type": "FUNCTION",
      "name": "pcgrandom.streams_pow2",
