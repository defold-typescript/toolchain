{
  "info": {
    "namespace": "pcgrandom",
    "brief": "PCG Random Extension",
    "description": "PCG Random Extension"
  },
  "elements": [
    {
      "type": "FUNCTION",
      "name": "pcgrandom.new_rng",
      "description": "Creates a new specified random number generator with a given seed and an optional stream for generators that support it.",
      "parameters": [
        {
          "name": "pcg_type",
          "doc": "PCG type.",
          "types": [
            "number"
          ]
        },
        {
          "name": "seed",
          "doc": "Seed number.",
          "types": [
            "number"
          ]
        },
        {
          "name": "stream",
          "doc": "Stream number.",
          "types": [
            "number"
          ],
          "is_optional": "True"
        }
      ],
      "returnvalues": [
        {
          "name": "rng",
          "doc": "RNG instance.",
          "types": [
            "lightuserdata"
          ]
        }
      ]
    },
    {
      "type": "FUNCTION",
      "name": "pcgrandom.new_rng_array",
      "description": "Creates a new specified extended random number generator with a given array for the extended data, seed and an optional stream for generators that support it.",
      "parameters": [
        {
          "name": "pcg_type",
          "doc": "PCG type.",
          "types": [
            "number"
          ]
        },
        {
          "name": "array",
          "doc": "Array with UINT32 numbers for the extended data, the size of the array must match the generator type.",
          "types": [
            "table"
          ]
        },
        {
          "name": "seed",
          "doc": "Seed number.",
          "types": [
            "number"
          ]
        },
        {
          "name": "stream",
          "doc": "Stream number.",
          "types": [
            "number"
          ],
          "is_optional": "True"
        }
      ],
      "returnvalues": [
        {
          "name": "rng",
          "doc": "RNG instance.",
          "types": [
            "lightuserdata"
          ]
        }
      ]
    },
    {
      "type": "FUNCTION",
      "name": "pcgrandom.next",
      "description": "Generates a pseudorandom integer number.",
      "parameters": [
        {
          "name": "rng",
          "doc": "RNG instance.",
          "types": [
            "lightuserdata"
          ]
        }
      ],
      "returnvalues": [
        {
          "name": "value",
          "doc": "Random value.",
          "types": [
            "number"
          ]
        }
      ]
    },
    {
      "type": "FUNCTION",
      "name": "pcgrandom.bound",
      "description": "Generates a pseudorandom integer number on [0,upper_bound) interval.",
      "parameters": [
        {
          "name": "rng",
          "doc": "RNG instance.",
          "types": [
            "lightuserdata"
          ]
        },
        {
          "name": "upper_bound",
          "doc": "Upper bound.",
          "types": [
            "number"
          ]
        }
      ],
      "returnvalues": [
        {
          "name": "value",
          "doc": "Random value.",
          "types": [
            "number"
          ]
        }
      ]
    },
    {
      "type": "FUNCTION",
      "name": "pcgrandom.range",
      "description": "Generates a pseudorandom integer number on [lower_bound,upper_bound) interval.",
      "parameters": [
        {
          "name": "rng",
          "doc": "RNG instance.",
          "types": [
            "lightuserdata"
          ]
        },
