    {
      "type": "FUNCTION",
      "name": "xmath.clamp",
      "description": "Clamp input value in range [min, max]. For numbers, pass (value, min, max) and returns the clamped number. For vectors, pass (v_in_place, value, min, max) to modify v_in_place. min and max can be numbers or matching vector types.",
      "parameters": [
        {
          "name": "value_or_out",
          "doc": "For numbers, the value to clamp. For vectors, the output vector to store the result.",
          "types": [
            "number",
            "vector3",
            "vector4"
          ]
        },
        {
          "name": "value_or_min",
          "doc": "For numbers, the minimum value. For vectors, the value to clamp.",
          "types": [
            "number",
            "vector3",
            "vector4"
          ]
        },
        {
          "name": "min_or_max",
          "doc": "For numbers, the maximum value. For vectors, the minimum value.",
          "types": [
            "number",
            "vector3",
            "vector4"
          ]
        },
        {
          "name": "max",
          "doc": "For vectors only, the maximum value.",
          "types": [
            "number",
            "vector3",
            "vector4"
          ]
        }
      ],
      "returnvalues": [
        {
          "name": "result",
          "doc": "For number inputs, returns the clamped number. For vector inputs, modifies v_in_place and returns nothing.",
          "types": [
            "number"
          ]
        }
      ]
