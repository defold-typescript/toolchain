    {
      "type": "FUNCTION",
      "name": "xmath.lerp",
      "description": "Linearly interpolate between two numbers, vectors, or quaternions. For numbers, pass (t, n1, n2) and returns the interpolated number. For vectors/quaternions, pass (v_in_place, t, v1, v2) to modify v_in_place.",
      "parameters": [
        {
          "name": "t_or_out",
          "doc": "For numbers, the interpolation factor. For vectors/quaternions, the output value to store the result.",
          "types": [
            "number",
            "vector3",
            "vector4",
            "quaternion"
          ]
        },
        {
          "name": "n1_or_t",
          "doc": "For numbers, the start value. For vectors/quaternions, the interpolation factor.",
          "types": [
            "number",
            "vector3",
            "vector4",
            "quaternion"
          ]
        },
        {
          "name": "n2_or_v1",
          "doc": "For numbers, the end value. For vectors/quaternions, the start value.",
          "types": [
            "number",
            "vector3",
            "vector4",
            "quaternion"
          ]
        },
        {
          "name": "v2",
          "doc": "For vectors/quaternions only, the end value.",
          "types": [
            "vector3",
            "vector4",
            "quaternion"
          ]
        }
      ],
      "returnvalues": [
        {
          "name": "result",
          "doc": "For number inputs, returns the interpolated number. For vector/quaternion inputs, modifies v_in_place and returns nothing.",
          "types": [
            "number"
          ]
        }
      ]
    },
