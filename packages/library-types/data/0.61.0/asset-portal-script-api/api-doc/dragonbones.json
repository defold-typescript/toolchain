{
  "info": {
    "namespace": "dragonbones",
    "brief": "Functions and constants for playing dragonbones animatios",
    "description": "Functions and constants for playing dragonbones animatios"
  },
  "elements": [
    {
      "type": "FUNCTION",
      "name": "dragonbones.create",
      "description": "initialize dragonbones with viewport width and height. Get instance object to be pass to all functions. called destroy to free this object.",
      "parameters": [],
      "returnvalues": [
        {
          "name": "instance",
          "doc": "Id of the game object",
          "types": [
            "userdata"
          ]
        }
      ]
    },
    {
      "type": "FUNCTION",
      "name": "dragonbones.load_data",
      "description": "Called after initialization. Pass in the skeleton and texture jsons as buffers.",
      "parameters": [
        {
          "name": "instance",
          "doc": "dragonbones instance.",
          "types": [
            "userdata"
          ]
        },
        {
          "name": "skeleton_json",
          "doc": "A resource buffer of skeleton json.",
          "types": [
            "handle"
          ]
        },
        {
          "name": "tex_json",
          "doc": "A resource buffer of atlas json.",
          "types": [
            "handle"
          ]
        },
        {
          "name": "aramture_index",
          "doc": "Optional. The armature index to built. Default is 0.",
          "types": [
            "integer"
          ]
        }
      ],
      "returnvalues": []
    },
    {
      "type": "FUNCTION",
      "name": "dragonbones.update",
      "description": "advance dragobones world by the given time delta.",
      "parameters": [
        {
          "name": "instance",
          "doc": "dragobones instance.",
          "types": [
            "userdata"
          ]
        },
        {
          "name": "dt",
          "doc": "1/fps, typically 1/60.0",
          "types": [
            "number"
          ]
        }
      ],
      "returnvalues": []
    },
    {
      "type": "FUNCTION",
      "name": "dragonbones.destroy",
      "description": "destroy this world. Make sure to free the buffers first",
      "parameters": [
        {
          "name": "instance",
          "doc": "dragobones instance.",
          "types": [
            "userdata"
          ]
        }
      ],
      "returnvalues": []
    },
    {
      "type": "FUNCTION",
      "name": "dragonbones.get_no_slots",
      "description": "Get the available slots in this world. You can use this to create specific no of meshes.",
      "parameters": [
        {
          "name": "instance",
          "doc": "dragobones instance.",
          "types": [
            "userdata"
          ]
        }
      ],
      "returnvalues": []
    },
    {
      "type": "FUNCTION",
      "name": "dragonbones.get_buffers",
      "description": "Get a table of slots. Sub table contain luaHBuffer buffer_trilist(a_position|a_texCoord|a_normal), matrix4 mtx_mvp ,  string slot_name, integer trilisit_count. buffer is vertices. mtx_mvp is the complete matrix. Use this data to create meshes.",
      "parameters": [
        {
          "name": "instance",
          "doc": "dragobones instance.",
          "types": [
            "userdata"
          ]
        }
      ],
      "returnvalues": [
        {
          "name": "slots_table",
          "doc": "2d table",
          "types": [
            "table"
          ]
        }
      ]
    },
    {
      "type": "FUNCTION",
      "name": "dragonbones.get_anination_names",
      "description": "Get a list of animations defined.",
      "parameters": [
        {
          "name": "instance",
          "doc": "dragobones instance.",
          "types": [
            "userdata"
          ]
        }
      ],
      "returnvalues": [
        {
          "name": "list",
          "doc": "a lua table of available animations to be use in fade_in_animation",
          "types": [
            "table"
          ]
        }
      ]
    },
    {
      "type": "FUNCTION",
      "name": "dragonbones.fade_in_animation",
      "description": "Play the specify animation",
      "parameters": [
        {
          "name": "instance",
          "doc": "dragobones instance.",
          "types": [
            "userdata"
          ]
        },
        {
          "name": "animation_name",
          "doc": "",
          "types": [
            "string"
          ]
        },
        {
          "name": "config",
          "doc": "field layer, blending layer default 0 field loop, -1 means use default value, 0 means loop infinitely, [1~N] means repeat N times. field fade_in_time, fadeIn time to enable blending and layering. field time_scale, default 1.0 [(-N~0) Reverse play, 0 Stop play, (0~1) Slow play, 1 Normal play, (1~N) Fast play]",
          "types": [
            "table"
          ]
        }
      ],
      "returnvalues": []
    },
