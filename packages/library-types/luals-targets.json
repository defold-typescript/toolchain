{
  "targets": [
    {
      "repo": "https://github.com/Insality/druid",
      "ref": "1.4.1",
      "license": "MIT",
      "sourceGlobs": ["druid/**/*.lua"],
      "moduleId": "druid.druid",
      "namespace": "druid",
      "typeRenames": {
        "vector": "Vector",
        "vector3": "Vector3",
        "vector4": "Vector4"
      },
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"],
      "externalTypes": { "event": { "module": "event.event", "name": "event" } },
      "annotationOverrides": {
        "interfaces": {
          "event.on_size_changed": {
            "fields": { "subscribe": { "drop": true } }
          },
          "druid.layout.rows_data": {
            "fields": { "rows": { "type": "druid.layout.row_data[]" } }
          },
          "druid.button.style": {
            "fields": {
              "on_init": { "type": "fun(self: druid.button)|nil" },
              "on_click": { "type": "fun(self: druid.button, node: node)|nil" },
              "on_click_disabled": { "type": "fun(self: druid.button, node: node)|nil" },
              "on_hover": {
                "type": "fun(self: druid.button, node: node, hover_state: boolean)|nil"
              },
              "on_mouse_hover": {
                "type": "fun(self: druid.button, node: node, hover_state: boolean)|nil"
              },
              "on_set_enabled": {
                "type": "fun(self: druid.button, node: node, enabled_state: boolean|nil)|nil"
              }
            }
          },
          "druid.drag": {
            "methods": {
              "init": {
                "params": {
                  "on_drag_callback": {
                    "type": "fun(self: any, dx: number, dy: number, x: number, y: number, touch: touch)"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "repo": "https://github.com/Insality/decore",
      "ref": "6",
      "license": "MIT",
      "sourceGlobs": ["decore/**/*.lua"],
      "moduleId": "decore.decore",
      "namespace": "decore",
      "typeRenames": {},
      "ignore": ["**/test/**", "**/example/**"]
    },
    {
      "repo": "https://github.com/Insality/defold-tweener",
      "ref": "6",
      "license": "MIT",
      "sourceGlobs": ["tweener/**/*.lua"],
      "moduleId": "tweener.tweener",
      "namespace": "tweener",
      "typeRenames": {
        "vector": "Vector",
        "vector3": "Vector3",
        "vector4": "Vector4"
      },
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"]
    },
    {
      "repo": "https://github.com/Insality/defold-event",
      "ref": "21",
      "license": "MIT",
      "sourceGlobs": ["event/**/*.lua"],
      "moduleId": "event.event",
      "namespace": "event",
      "typeRenames": {},
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"]
    },
    {
      "repo": "https://github.com/Insality/defold-lang",
      "ref": "5",
      "license": "MIT",
      "sourceGlobs": ["lang/**/*.lua"],
      "moduleId": "lang.lang",
      "namespace": "lang",
      "typeRenames": {},
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"]
    },
    {
      "repo": "https://github.com/Insality/defold-log",
      "ref": "7",
      "license": "MIT",
      "sourceGlobs": ["log/**/*.lua"],
      "moduleId": "log.log",
      "namespace": "log",
      "typeRenames": { "debuginfo": "debug.FunctionInfo" },
      "annotationOverrides": {
        "interfaces": { "log": { "callSignature": { "drop": true } } }
      },
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"]
