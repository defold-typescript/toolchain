      "moduleId": "saver.storage",
      "namespace": "saver.storage",
      "typeRenames": {},
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"]
    },
    {
      "repo": "https://github.com/paweljarosz/lua-immutable",
      "ref": "v1.1",
      "license": "MIT",
      "sourceGlobs": ["immutable/**/*.lua"],
      "moduleId": "immutable.immutable",
      "namespace": "immutable",
      "typeRenames": {},
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"]
    },
    {
      "repo": "https://github.com/paweljarosz/squid",
      "ref": "1.2",
      "license": "MIT",
      "sourceGlobs": ["squid/**/*.lua"],
      "moduleId": "squid.squid",
      "namespace": "squid",
      "typeRenames": {},
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"]
    },
    {
      "repo": "https://github.com/astrochili/narrator",
      "ref": "1.8",
      "license": "MIT",
      "sourceGlobs": ["narrator/annotations.lua", "narrator/narrator.lua", "narrator/story.lua"],
      "moduleId": "narrator.narrator",
      "namespace": "narrator",
      "typeRenames": {},
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"],
      "annotationOverrides": {
        "moduleFunctions": {
          "parse_content": { "params": { "inclusions": { "optional": true } } }
        },
        "interfaces": {
          "Narrator.Story": {
            "methods": {
              "continue": { "return": "Narrator.Paragraph[]|Narrator.Paragraph" },
              "observe": { "params": { "observer": { "type": "fun(value: any)" } } }
            }
          }
        }
      }
    },
    {
      "repo": "https://github.com/Insality/panthera",
      "ref": "runtime.11",
      "license": "MIT",
      "sourceGlobs": ["panthera/**/*.lua"],
      "moduleId": "panthera.panthera",
      "namespace": "panthera",
      "typeRenames": {
        "vector": "Vector"
      },
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"]
    },
    {
      "repo": "https://github.com/Insality/detiled",
      "ref": "3",
      "license": "MIT",
      "sourceGlobs": ["detiled/**/*.lua"],
      "moduleId": "detiled.detiled",
      "namespace": "detiled",
      "typeRenames": {},
      "ignore": ["**/test/**", "**/example/**"]
    },
    {
      "repo": "https://github.com/Insality/defold-token",
      "ref": "9",
      "license": "MIT",
      "sourceGlobs": ["token/**/*.lua"],
      "moduleId": "token.token",
      "namespace": "token",
      "typeRenames": {},
      "ignore": ["**/test/**", "**/example/**"],
      "externalTypes": { "event": { "module": "event.event", "name": "event" } },
      "annotationOverrides": {
        "interfaces": {
          "token.container.event.on_token_change": {
            "fields": { "trigger": { "drop": true }, "subscribe": { "drop": true } }
          },
          "token.container.event.on_token_visual_change": {
            "fields": { "trigger": { "drop": true }, "subscribe": { "drop": true } }
          },
          "token.event.on_token_change": {
            "fields": { "trigger": { "drop": true }, "subscribe": { "drop": true } }
          },
          "token.event.on_token_visual_change": {
            "fields": { "trigger": { "drop": true }, "subscribe": { "drop": true } }
          },
          "token.event.on_token_restore_change": {
            "fields": { "trigger": { "drop": true }, "subscribe": { "drop": true } }
          },
          "token.container": { "methods": { "get": { "return": "number" } } }
        },
        "moduleObject": {
          "interface": "token",
          "fields": {
            "on_token_change": { "type": "token.event.on_token_change" },
            "on_token_visual_change": { "type": "token.event.on_token_visual_change" },
            "on_token_restore_change": { "type": "token.event.on_token_restore_change" }
          }
        }
      }
    },
    {
      "repo": "https://github.com/Insality/defold-quest",
      "ref": "3",
      "license": "MIT",
      "sourceGlobs": ["quest/**/*.lua"],
      "moduleId": "quest.quest",
      "namespace": "quest",
      "typeRenames": {},
      "ignore": ["**/test/**", "**/example/**"],
      "externalTypes": {
        "event": { "module": "event.event", "name": "event" },
        "queue": { "module": "event.event", "name": "queue" }
      },
      "annotationOverrides": {
        "interfaces": {
          "quest.queue.quest_event": {
            "fields": { "subscribe": { "drop": true } }
          },
          "quest.event.is_can_start": {
            "fields": { "trigger": { "drop": true }, "subscribe": { "drop": true } }
          },
          "quest.event.is_can_complete": {
            "fields": { "trigger": { "drop": true }, "subscribe": { "drop": true } }
          },
          "quest.event.is_can_event": {
            "fields": { "trigger": { "drop": true }, "subscribe": { "drop": true } }
          }
        },
        "moduleObject": {
          "interface": "quest",
          "fields": {
            "on_quest_event": { "type": "quest.queue.quest_event" },
            "is_can_start": { "type": "quest.event.is_can_start" },
            "is_can_complete": { "type": "quest.event.is_can_complete" },
            "is_can_event": { "type": "quest.event.is_can_event" }
          }
        }
      }
    },
    {
      "repo": "https://github.com/paweljarosz/pigeon",
      "ref": "v1.5",
      "license": "MIT",
      "sourceGlobs": ["pigeon/**/*.lua"],
      "moduleId": "pigeon.pigeon",
      "namespace": "pigeon",
      "typeRenames": { "vector": "Vector", "vector3": "Vector3", "vector4": "Vector4" },
      "ignore": ["**/test/**", "pigeon/test.lua"],
      "annotationOverrides": {
        "interfaces": {
          "BaseLetterDefinition": {
            "fields": { "data": { "drop": true } }
          }
        }
      }
    },
    {
      "repo": "https://github.com/HGPoint/defold_live_unbundler",
      "ref": "2.3",
      "license": "MIT",
      "sourceGlobs": ["live_unbundler/**/*.lua"],
      "moduleId": "live_unbundler.live_unbundler",
      "namespace": "live_unbundler",
      "annotationOverrides": {
        "moduleConstants": {
          "MSG_INITIALIZED": {
            "type": "hash",
            "doc": "Posted to every listener once `init` finishes."
          },
          "MSG_INITIALIZATION_FAILED": {
            "type": "hash",
            "doc": "Message id reserved for a failed initialization; this version never posts it."
          },
          "MSG_FILE_LOADED": {
            "type": "hash",
            "doc": "Posted with `file_name` and `module_name` each time an archive is mounted."
          },
          "MSG_MODULE_LOADED": {
            "type": "hash",
            "doc": "Posted with `file_name` and `module_name` once every archive of a module is mounted."
          },
          "MSG_ALL_LOADED": {
            "type": "hash",
            "doc": "Posted once every queued archive is mounted."
          },
          "MSG_NETWORK_ERROR": {
            "type": "hash",
            "doc": "Posted when an archive download fails; the download retries after five seconds."
          },
          "DEBUG": {
            "type": "integer",
            "doc": "Debug log level passed to the `set_log_function` callback."
          },
          "INFO": {
            "type": "integer",
            "doc": "Info log level passed to the `set_log_function` callback."
          },
          "WARN": {
            "type": "integer",
            "doc": "Warning log level passed to the `set_log_function` callback."
          },
          "ERROR": {
            "type": "integer",
            "doc": "Error log level passed to the `set_log_function` callback."
          },
          "FATAL": {
            "type": "integer",
            "doc": "Fatal log level passed to the `set_log_function` callback."
          },
          "RES_HIGH_ONLY": {
            "type": "liveupdater.res_mode",
            "doc": "`res_mode` that loads only the high-resolution archives; the default."
          },
          "RES_LOW_ONLY": {
            "type": "liveupdater.res_mode",
            "doc": "`res_mode` that loads only the low-resolution archives."
          },
          "RES_BOTH": {
            "type": "liveupdater.res_mode",
            "doc": "`res_mode` that loads both resolutions."
          }
        }
      }
    },
    {
      "repo": "https://github.com/potatojam/defold-ads-wrapper",
      "ref": "1.5.1",
      "license": "MIT",
      "sourceGlobs": [
        "ads_wrapper/*.lua",
        "ads_wrapper/ads_networks/ads_network.lua",
        "ads_wrapper/ads_networks/test.lua"
      ],
      "moduleId": "ads_wrapper.ads_wrapper",
      "namespace": "ads_wrapper.ads_wrapper",
      "typeRenames": {
        "bool": "boolean"
      },
      "annotationOverrides": {
        "moduleConstants": {
          "T_REWARDED": {
            "type": "hash",
            "doc": "Rewarded-video ad type, used to set network parameters."
          },
          "T_INTERSTITIAL": {
            "type": "hash",
            "doc": "Interstitial ad type, used to set network parameters."
          },
          "T_BANNER": {
            "type": "hash",
            "doc": "Banner ad type, used to set network parameters."
          }
        }
      }
    },
    {
      "repo": "https://github.com/potatojam/defold-ads-wrapper",
      "ref": "1.5.1",
      "license": "MIT",
      "sourceGlobs": [
        "ads_wrapper/*.lua",
        "ads_wrapper/ads_networks/ads_network.lua",
        "ads_wrapper/ads_networks/test.lua"
      ],
      "moduleId": "ads_wrapper.events",
      "namespace": "ads_wrapper.events",
      "typeRenames": {
        "bool": "boolean"
      },
      "annotationOverrides": {
        "moduleConstants": {
          "ABORT": {
            "type": "hash",
            "doc": "Result a network step returns to stop the queue early; the callback receives it as `SUCCESS`."
          },
          "SUCCESS": {
            "type": "hash",
            "doc": "`response.result` when the call succeeded."
          },
          "ERROR": {
            "type": "hash",
            "doc": "`response.result` when the call failed."
          },
          "C_SKIPPED": {
            "type": "hash",
            "doc": "`response.code` when the rewarded ad was skipped."
          },
          "C_ERROR_UNKNOWN": {
            "type": "hash",
            "doc": "`response.code` for an unknown error."
          },
          "C_ERROR_AD_BLOCK": {
            "type": "hash",
            "doc": "`response.code` when an ad blocker caused the error."
          },
          "C_ERROR_NO_CONNECTION": {
            "type": "hash",
            "doc": "`response.code` when there is no internet connection."
          },
          "V_NONE": {
            "type": "hash",
            "doc": "`queue.set_verbose_mode` level that logs nothing; the default."
          },
          "V_ERROR": {
            "type": "hash",
            "doc": "`queue.set_verbose_mode` level that logs every error."
          },
          "V_SUCCESS": {
            "type": "hash",
            "doc": "`queue.set_verbose_mode` level that logs every success response."
          },
          "V_ALL": {
            "type": "hash",
            "doc": "`queue.set_verbose_mode` level that logs every message."
          }
        }
      }
    },
    {
      "repo": "https://github.com/potatojam/defold-ads-wrapper",
      "ref": "1.5.1",
      "license": "MIT",
      "sourceGlobs": [
        "ads_wrapper/*.lua",
        "ads_wrapper/ads_networks/ads_network.lua",
        "ads_wrapper/ads_networks/test.lua"
      ],
      "moduleId": "ads_wrapper.platform",
      "namespace": "ads_wrapper.platform",
      "typeRenames": {
        "bool": "boolean"
      },
      "annotationOverrides": {
        "moduleConstants": {
          "PL_ANDROID": {
            "type": "hash",
            "doc": "Android, as returned by `get` and checked by `is_same`."
          },
          "PL_IOS": {
            "type": "hash",
            "doc": "iOS, as returned by `get` and checked by `is_same`."
          },
          "PL_HTML5": {
            "type": "hash",
            "doc": "HTML5, as returned by `get` and checked by `is_same`."
          },
          "PL_OTHER": {
            "type": "hash",
            "doc": "Any other platform, as returned by `get` and checked by `is_same`."
          }
        }
      }
    },
    {
      "repo": "https://github.com/potatojam/defold-ads-wrapper",
      "ref": "1.5.1",
      "license": "MIT",
      "sourceGlobs": [
        "ads_wrapper/*.lua",
        "ads_wrapper/ads_networks/ads_network.lua",
        "ads_wrapper/ads_networks/test.lua"
      ],
      "moduleId": "ads_wrapper.queue",
      "namespace": "ads_wrapper.queue",
      "typeRenames": {
        "bool": "boolean"
      },
      "annotationOverrides": {
        "moduleFunctions": {
          "add": {
            "params": {
              "fn": {
                "type": "fun(network: ads_network, callback: ads_callback, params?: table)"
              }
            }
          }
        }
      }
    },
    {
      "repo": "https://github.com/potatojam/defold-ads-wrapper",
      "ref": "1.5.1",
      "license": "MIT",
      "sourceGlobs": [
        "ads_wrapper/*.lua",
        "ads_wrapper/ads_networks/ads_network.lua",
        "ads_wrapper/ads_networks/test.lua"
      ],
      "moduleId": "ads_wrapper.ads_networks.test",
      "namespace": "ads_wrapper.ads_networks.test",
      "typeRenames": {
        "bool": "boolean"
      },
      "annotationOverrides": {
        "moduleConstants": {
          "network1": {
            "type": "ads_network",
            "doc": "Test network that logs each call and succeeds without showing an ad."
          },
          "network2": {
            "type": "ads_network",
            "doc": "Second test network, for trying mediation across two networks."
          }
        }
      }
    }
  ]
}
