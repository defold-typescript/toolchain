      "sourceGlobs": ["saver/**/*.lua"],
      "moduleId": "saver.saver",
      "namespace": "saver.saver",
      "typeRenames": {},
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"]
    },
    {
