{
  "targets": [
    {
      "repo": "https://github.com/Insality/druid",
      "ref": "1.2.5",
      "license": "MIT",
      "sourceGlobs": ["druid/**/*.lua"],
      "moduleId": "druid.druid",
      "namespace": "druid",
      "typeRenames": {
        "vector": "Vector",
        "vector3": "Vector3",
        "vector4": "Vector4"
      },
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"],
      "externalTypes": { "event": { "module": "event.event", "name": "event" } },
      "annotationOverrides": {
        "interfaces": {
          "event.on_size_changed": {
            "fields": { "subscribe": { "drop": true } }
          },
          "druid.layout.rows_data": {
            "fields": { "rows": { "type": "druid.layout.row_data[]" } }
          },
          "druid.button.style": {
            "fields": {
              "on_init": { "type": "fun(self: druid.button)|nil" },
              "on_click": { "type": "fun(self: druid.button, node: node)|nil" },
              "on_click_disabled": { "type": "fun(self: druid.button, node: node)|nil" },
              "on_hover": {
                "type": "fun(self: druid.button, node: node, hover_state: boolean)|nil"
              },
              "on_mouse_hover": {
                "type": "fun(self: druid.button, node: node, hover_state: boolean)|nil"
              },
              "on_set_enabled": {
                "type": "fun(self: druid.button, node: node, enabled_state: boolean|nil)|nil"
              }
            }
          },
          "druid.drag": {
            "methods": {
              "init": {
                "params": {
                  "on_drag_callback": {
                    "type": "fun(self: any, dx: number, dy: number, x: number, y: number, touch: touch)"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "repo": "https://github.com/Insality/decore",
      "ref": "4",
      "license": "MIT",
      "sourceGlobs": ["decore/**/*.lua"],
      "moduleId": "decore.decore",
      "namespace": "decore",
      "typeRenames": {},
      "ignore": ["**/test/**", "**/example/**"]
    },
    {
      "repo": "https://github.com/Insality/defold-tweener",
      "ref": "6",
      "license": "MIT",
      "sourceGlobs": ["tweener/**/*.lua"],
      "moduleId": "tweener.tweener",
      "namespace": "tweener",
      "typeRenames": {
        "vector": "Vector",
        "vector3": "Vector3",
        "vector4": "Vector4"
      },
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"]
    },
    {
      "repo": "https://github.com/Insality/defold-event",
      "ref": "19",
      "license": "MIT",
      "sourceGlobs": ["event/**/*.lua"],
      "moduleId": "event.event",
      "namespace": "event",
      "typeRenames": {},
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"]
    },
    {
      "repo": "https://github.com/Insality/defold-lang",
      "ref": "5",
      "license": "MIT",
      "sourceGlobs": ["lang/**/*.lua"],
      "moduleId": "lang.lang",
      "namespace": "lang",
      "typeRenames": {},
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"]
    },
    {
      "repo": "https://github.com/Insality/defold-log",
      "ref": "6",
      "license": "MIT",
      "sourceGlobs": ["log/**/*.lua"],
      "moduleId": "log.log",
      "namespace": "log",
      "typeRenames": { "debuginfo": "debug.FunctionInfo" },
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"]
    },
    {
      "repo": "https://github.com/Insality/defold-proto",
      "ref": "1",
      "license": "MIT",
      "sourceGlobs": ["proto/**/*.lua"],
      "moduleId": "proto.proto",
      "namespace": "proto",
      "typeRenames": {},
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"]
    },
    {
      "repo": "https://github.com/Insality/defold-saver",
      "ref": "8",
      "license": "MIT",
      "sourceGlobs": ["saver/**/*.lua"],
      "moduleId": "saver.saver",
      "namespace": "saver.saver",
      "typeRenames": {},
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"]
    },
    {
      "repo": "https://github.com/Insality/defold-saver",
      "ref": "8",
      "license": "MIT",
      "sourceGlobs": ["saver/**/*.lua"],
      "moduleId": "saver.storage",
      "namespace": "saver.storage",
      "typeRenames": {},
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"]
    },
    {
      "repo": "https://github.com/paweljarosz/lua-immutable",
      "ref": "v1.1",
      "license": "MIT",
      "sourceGlobs": ["immutable/**/*.lua"],
      "moduleId": "immutable.immutable",
      "namespace": "immutable",
      "typeRenames": {},
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"]
    },
    {
      "repo": "https://github.com/paweljarosz/squid",
      "ref": "1.2",
      "license": "MIT",
      "sourceGlobs": ["squid/**/*.lua"],
      "moduleId": "squid.squid",
      "namespace": "squid",
      "typeRenames": {},
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"]
    },
    {
      "repo": "https://github.com/astrochili/narrator",
      "ref": "1.8",
      "license": "MIT",
      "sourceGlobs": ["narrator/annotations.lua", "narrator/narrator.lua", "narrator/story.lua"],
      "moduleId": "narrator.narrator",
      "namespace": "narrator",
      "typeRenames": {},
      "ignore": ["**/test/**", "**/example/**", "**/example_*/**"],
      "annotationOverrides": {
        "moduleFunctions": {
          "parse_content": { "params": { "inclusions": { "optional": true } } }
        },
        "interfaces": {
          "Narrator.Story": {
            "methods": {
              "continue": { "return": "Narrator.Paragraph[]|Narrator.Paragraph" },
              "observe": { "params": { "observer": { "type": "fun(value: any)" } } }
            }
          }
        }
      }
    }
  ]
}
