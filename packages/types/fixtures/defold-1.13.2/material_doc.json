    {
      "type": "TYPEDEF",
      "name": "material.constant_value",
      "brief": "Material constant value",
      "description": "A value accepted by <a href=\"/ref/material#material.set_constants\">material.set_constants</a> when updating a shader\nconstant. Use a number or vector for user vector constants, a <span class=\"type\">matrix4</span>\nfor matrix constants, and an array to update a shader constant array.",
      "returnvalues": [],
      "parameters": [
        {
          "name": "value",
          "doc": "",
          "types": [
            "number",
            "vector3",
            "vector4",
            "matrix4",
            "(number|vector3|vector4|matrix4)[]"
          ],
          "is_optional": "False"
        }
      ],
      "examples": "<div class=\"codehilite\"><pre><span></span><code><span class=\"n\">material</span><span class=\"p\">.</span><span class=\"n\">set_constants</span><span class=\"p\">(</span><span class=\"n\">self</span><span class=\"p\">.</span><span class=\"n\">material</span><span class=\"p\">,</span> <span class=\"p\">{</span>\n    <span class=\"n\">tint</span> <span class=\"o\">=</span> <span class=\"p\">{</span> <span class=\"n\">value</span> <span class=\"o\">=</span> <span class=\"n\">vmath</span><span class=\"p\">.</span><span class=\"n\">vector4</span><span class=\"p\">(</span><span class=\"mi\">1</span><span class=\"p\">,</span> <span class=\"mf\">0.5</span><span class=\"p\">,</span> <span class=\"mf\">0.5</span><span class=\"p\">,</span> <span class=\"mi\">1</span><span class=\"p\">)</span> <span class=\"p\">},</span>\n    <span class=\"n\">weights</span> <span class=\"o\">=</span> <span class=\"p\">{</span> <span class=\"n\">value</span> <span class=\"o\">=</span> <span class=\"p\">{</span> <span class=\"mf\">0.25</span><span class=\"p\">,</span> <span class=\"mf\">0.5</span><span class=\"p\">,</span> <span class=\"mf\">0.75</span><span class=\"p\">,</span> <span class=\"mi\">1</span> <span class=\"p\">}</span> <span class=\"p\">}</span>\n<span class=\"p\">})</span>\n</code></pre></div>",
      "replaces": "",
      "error": "",
      "tparams": [],
      "members": [],
      "notes": [],
      "language": ""
    },
    {
      "type": "TYPEDEF",
      "name": "material.constant_info_value",
      "brief": "Material constant result value",
      "description": "The value of a user constant returned in a <span class=\"type\">material.constant_info</span>\nentry by <a href=\"/ref/material#material.get_constants\">material.get_constants</a>. A scalar constant is returned as a\n<span class=\"type\">vector4</span> or <span class=\"type\">matrix4</span>; a shader constant array is returned as an\narray of those values. Non-user constants do not include a <code>value</code> field.",
      "returnvalues": [],
      "parameters": [
        {
          "name": "value",
          "doc": "",
          "types": ["vector4", "matrix4", "vector4[]", "matrix4[]"],
          "is_optional": "False"
        }
      ],
      "examples": "<div class=\"codehilite\"><pre><span></span><code><span class=\"kr\">for</span> <span class=\"n\">_</span><span class=\"p\">,</span> <span class=\"n\">constant</span> <span class=\"kr\">in</span> <span class=\"nb\">ipairs</span><span class=\"p\">(</span><span class=\"n\">material</span><span class=\"p\">.</span><span class=\"n\">get_constants</span><span class=\"p\">(</span><span class=\"n\">self</span><span class=\"p\">.</span><span class=\"n\">material</span><span class=\"p\">))</span> <span class=\"kr\">do</span>\n    <span class=\"kr\">if</span> <span class=\"n\">constant</span><span class=\"p\">.</span><span class=\"n\">value</span> <span class=\"kr\">then</span>\n        <span class=\"n\">pprint</span><span class=\"p\">(</span><span class=\"n\">constant</span><span class=\"p\">.</span><span class=\"n\">name</span><span class=\"p\">,</span> <span class=\"n\">constant</span><span class=\"p\">.</span><span class=\"n\">value</span><span class=\"p\">)</span>\n    <span class=\"kr\">end</span>\n<span class=\"kr\">end</span>\n</code></pre></div>",
      "replaces": "",
      "error": "",
      "tparams": [],
      "members": [],
      "notes": [],
      "language": ""
    },
    {
      "type": "TYPEDEF",
      "name": "material.vertex_attribute_value",
      "brief": "Material vertex attribute value",
      "description": "A vertex attribute value accepted by <a href=\"/ref/material#material.set_vertex_attributes\">material.set_vertex_attributes</a>\nand returned by <a href=\"/ref/material#material.get_vertex_attributes\">material.get_vertex_attributes</a>. Use a number or vector\nfor scalar and vector attributes, <span class=\"type\">matrix4</span> for a 4x4 matrix, and a flat\narray of numbers for matrix shapes that do not map to <span class=\"type\">matrix4</span>.",
      "returnvalues": [],
      "parameters": [
        {
          "name": "value",
          "doc": "",
          "types": ["number", "vector3", "vector4", "matrix4", "number[]"],
          "is_optional": "False"
        }
      ],
      "examples": "<div class=\"codehilite\"><pre><span></span><code><span class=\"n\">material</span><span class=\"p\">.</span><span class=\"n\">set_vertex_attributes</span><span class=\"p\">(</span><span class=\"n\">self</span><span class=\"p\">.</span><span class=\"n\">material</span><span class=\"p\">,</span> <span class=\"p\">{</span>\n    <span class=\"n\">tint</span> <span class=\"o\">=</span> <span class=\"p\">{</span> <span class=\"n\">value</span> <span class=\"o\">=</span> <span class=\"n\">vmath</span><span class=\"p\">.</span><span class=\"n\">vector4</span><span class=\"p\">(</span><span class=\"mi\">1</span><span class=\"p\">,</span> <span class=\"mi\">0</span><span class=\"p\">,</span> <span class=\"mi\">0</span><span class=\"p\">,</span> <span class=\"mi\">1</span><span class=\"p\">)</span> <span class=\"p\">},</span>\n    <span class=\"n\">transform_2d</span> <span class=\"o\">=</span> <span class=\"p\">{</span> <span class=\"n\">value</span> <span class=\"o\">=</span> <span class=\"p\">{</span> <span class=\"mi\">1</span><span class=\"p\">,</span> <span class=\"mi\">0</span><span class=\"p\">,</span> <span class=\"mi\">0</span><span class=\"p\">,</span> <span class=\"mi\">0</span><span class=\"p\">,</span> <span class=\"mi\">1</span><span class=\"p\">,</span> <span class=\"mi\">0</span><span class=\"p\">,</span> <span class=\"mi\">0</span><span class=\"p\">,</span> <span class=\"mi\">0</span><span class=\"p\">,</span> <span class=\"mi\">1</span> <span class=\"p\">}</span> <span class=\"p\">}</span>\n<span class=\"p\">})</span>\n</code></pre></div>",
      "replaces": "",
      "error": "",
      "tparams": [],
      "members": [],
      "notes": [],
      "language": ""
    },
