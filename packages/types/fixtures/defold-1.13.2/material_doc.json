    {
      "type": "FUNCTION",
      "name": "material.get_vertex_attributes",
      "brief": "gets vertex attributes from a material",
      "description": "Returns a table of all the vertex attributes in the material. This function will return all the vertex attributes\nthat are used in the vertex shader of the material.",
      "returnvalues": [
        {
          "name": "attributes",
          "doc": "vertex attribute information",
          "types": ["material.vertex_attribute_info[]"]
        }
      ],
      "parameters": [
        {
          "name": "path",
          "doc": "The path to the resource",
          "types": ["hash", "string"],
          "is_optional": "False"
        }
      ],
      "examples": "Get the vertex attributes from a material specified as a resource property\n<div class=\"codehilite\"><pre><span></span><code><span class=\"n\">go</span><span class=\"p\">.</span><span class=\"n\">property</span><span class=\"p\">(</span><span class=\"s2\">&quot;my_material&quot;</span><span class=\"p\">,</span> <span class=\"n\">resource</span><span class=\"p\">.</span><span class=\"n\">material</span><span class=\"p\">())</span>\n\n<span class=\"kr\">function</span> <span class=\"nf\">init</span><span class=\"p\">(</span><span class=\"n\">self</span><span class=\"p\">)</span>\n    <span class=\"kd\">local</span> <span class=\"n\">vertex_attributes</span> <span class=\"o\">=</span> <span class=\"n\">material</span><span class=\"p\">.</span><span class=\"n\">get_vertex_attributes</span><span class=\"p\">(</span><span class=\"n\">self</span><span class=\"p\">.</span><span class=\"n\">my_material</span><span class=\"p\">)</span>\n<span class=\"kr\">end</span>\n</code></pre></div>",
      "replaces": "",
      "error": "",
      "tparams": [],
      "members": [],
      "notes": [],
      "language": ""
    },
    {
      "type": "FUNCTION",
      "name": "material.get_samplers",
