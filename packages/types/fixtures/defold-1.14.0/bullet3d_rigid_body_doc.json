{
  "elements": [
    {
      "type": "ENUM",
      "name": "bullet3d.rigid_body.FLAG",
      "brief": "Rigid body flags",
      "description": "Combine these constants into the complete flag mask accepted by\n<code>bullet3d.rigid_body.set_flags()</code>.",
      "returnvalues": [],
      "parameters": [],
      "examples": "",
      "replaces": "",
      "error": "",
      "tparams": [],
      "members": [
        {
          "name": "BT_DISABLE_WORLD_GRAVITY",
          "doc": "Disable automatic world gravity. Set this bit before assigning custom body gravity that must survive later world-gravity changes or re-adding the body to a world.",
          "type": ""
        },
        {
          "name": "BT_ENABLE_GYROSCOPIC_FORCE_EXPLICIT",
          "doc": "Enable explicit gyroscopic force integration.",
          "type": ""
        },
        {
          "name": "BT_ENABLE_GYROSCOPIC_FORCE_IMPLICIT_WORLD",
          "doc": "Enable implicit world-space gyroscopic force integration.",
          "type": ""
        },
        {
          "name": "BT_ENABLE_GYROSCOPIC_FORCE_IMPLICIT_BODY",
          "doc": "Enable implicit body-space gyroscopic force integration. This flag is enabled by default for newly constructed rigid bodies.",
          "type": ""
        }
      ],
      "notes": [],
      "language": ""
    },
