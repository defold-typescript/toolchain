          "types": ["btRigidBody"],
          "is_optional": "False"
        }
      ],
      "examples": "",
      "replaces": "",
      "error": "",
      "tparams": [],
      "members": [],
      "notes": [],
      "language": ""
    },
    {
      "type": "FUNCTION",
      "name": "bullet3d.rigid_body.set_mass_properties",
      "brief": "Set explicit mass properties",
      "description": "Sets mass and diagonal local inertia together, updates the world-space\ninertia tensor, and activates the body. Only dynamic bodies are accepted.\nA zero inertia component is allowed and disables angular response on that\nlocal axis; negative, non-finite, or nonzero values too small to have a\nfinite native inverse are rejected.",
      "returnvalues": [],
      "parameters": [
        {
          "name": "body",
          "doc": "dynamic rigid body",
          "types": ["btRigidBody"],
          "is_optional": "False"
        },
        {
          "name": "mass",
          "doc": "finite mass greater than zero",
          "types": ["number"],
          "is_optional": "False"
        },
        {
          "name": "local_inertia",
          "doc": "finite non-negative diagonal local inertia in Defold mass-times-distance-squared units",
          "types": ["vector3"],
          "is_optional": "False"
        }
      ],
      "examples": "",
      "replaces": "",
      "error": "",
      "tparams": [],
      "members": [],
