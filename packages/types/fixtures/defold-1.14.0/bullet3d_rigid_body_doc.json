    {
      "type": "FUNCTION",
      "name": "bullet3d.rigid_body.set_mass",
      "brief": "Set mass and calculate local inertia",
      "description": "Recalculates local inertia from the body's current collision shape. Only a\ndynamic body can be changed; zero mass cannot be used to convert it into a\nstatic body. Values too small to have a finite native inverse are rejected.\nThe body is activated after the update.",
      "returnvalues": [],
      "parameters": [
        {
          "name": "body",
          "doc": "dynamic rigid body",
          "types": ["btRigidBody"],
          "is_optional": "False"
        },
        {
          "name": "mass",
          "doc": "finite mass greater than zero",
          "types": ["number"],
          "is_optional": "False"
        }
      ],
      "examples": "Change the mass of a dynamic collision object and inspect its recalculated inertia:\n<div class=\"codehilite\"><pre><span></span><code><span class=\"kr\">function</span> <span class=\"nf\">init</span><span class=\"p\">(</span><span class=\"n\">self</span><span class=\"p\">)</span>\n    <span class=\"kd\">local</span> <span class=\"n\">body</span> <span class=\"o\">=</span> <span class=\"n\">bullet3d</span><span class=\"p\">.</span><span class=\"n\">get_rigid_body</span><span class=\"p\">(</span><span class=\"s2\">&quot;#collisionobject&quot;</span><span class=\"p\">)</span>\n    <span class=\"n\">bullet3d</span><span class=\"p\">.</span><span class=\"n\">rigid_body</span><span class=\"p\">.</span><span class=\"n\">set_mass</span><span class=\"p\">(</span><span class=\"n\">body</span><span class=\"p\">,</span> <span class=\"mi\">5</span><span class=\"p\">)</span>\n    <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"s2\">&quot;local inertia&quot;</span><span class=\"p\">,</span> <span class=\"n\">bullet3d</span><span class=\"p\">.</span><span class=\"n\">rigid_body</span><span class=\"p\">.</span><span class=\"n\">get_local_inertia</span><span class=\"p\">(</span><span class=\"n\">body</span><span class=\"p\">))</span>\n<span class=\"kr\">end</span>\n</code></pre></div>",
      "replaces": "",
      "error": "",
      "tparams": [],
      "members": [],
      "notes": [],
      "language": ""
    },
    {
      "type": "FUNCTION",
      "name": "bullet3d.rigid_body.get_local_inertia",
      "brief": "Get local inertia",
      "description": "Returns the diagonal local inertia in Defold mass-times-distance-squared\nunits. A zero component denotes an axis with zero inverse inertia.",
      "returnvalues": [
        {
          "name": "inertia",
          "doc": "diagonal local inertia",
          "types": ["vector3"]
        }
      ],
      "parameters": [
        {
