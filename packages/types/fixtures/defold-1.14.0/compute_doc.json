    {
      "type": "FUNCTION",
      "name": "compute.get_samplers",
      "brief": "gets texture samplers from a compute program",
      "description": "Returns a table of all the texture samplers in the compute program. This function will return all the texture samplers\nthat are available, even the ones that have not been specified in the compute resource.",
      "returnvalues": [
        {
          "name": "table",
          "doc": "Information about the texture samplers.",
          "types": ["material.sampler_info[]"]
        }
      ],
      "parameters": [
        {
          "name": "path",
          "doc": "The path to the resource",
          "types": ["hash", "string"],
          "is_optional": "False"
        }
      ],
      "examples": "Get the texture samplers from a compute program resource\n<div class=\"codehilite\"><pre><span></span><code><span class=\"kr\">function</span> <span class=\"nf\">init</span><span class=\"p\">(</span><span class=\"n\">self</span><span class=\"p\">)</span>\n    <span class=\"kd\">local</span> <span class=\"n\">samplers</span> <span class=\"o\">=</span> <span class=\"n\">compute</span><span class=\"p\">.</span><span class=\"n\">get_samplers</span><span class=\"p\">(</span><span class=\"s2\">&quot;/my_compute.computec&quot;</span><span class=\"p\">)</span>\n<span class=\"kr\">end</span>\n</code></pre></div>",
      "replaces": "",
      "error": "",
      "tparams": [],
      "members": [],
      "notes": [],
      "language": ""
    },
