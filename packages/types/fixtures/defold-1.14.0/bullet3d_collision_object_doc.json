  "info": {
    "namespace": "bullet3d.collision_object",
    "name": "bullet3d.collision_object",
    "brief": "Bullet collision object API",
    "description": "Functions shared by rigid bodies and trigger ghost objects. Defold keeps\nownership of each object's user pointer, motion state, collision shape, and\nworld membership. Logical child shapes are inspected and mutated through\n`bullet3d.shape`; ownership is not transferred to Lua.\n\nPositions, distances, and CCD thresholds use Defold units. Rotations,\ncoefficients, flags, activation state, and time values use Bullet values.\nFloating-point and vector inputs must be finite. CCD radii and motion\nthresholds must also be non-negative.",
    "path": "engine/gamesys/src/gamesys/scripts/bullet3d/script_bullet3d_collision_object.cpp",
    "file": "",
    "notes": [],
    "language": "Lua"
  },
