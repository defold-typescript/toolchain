    {
      "type": "FUNCTION",
      "name": "bullet3d.collision_object.set_world_transform",
      "brief": "Set the world transform",
      "description": "The owning game object's position and rotation are updated as well, so the\ntransform persists when Defold synchronizes game objects into Bullet.",
      "returnvalues": [],
      "parameters": [
        {
          "name": "object",
          "doc": "collision object",
          "types": ["btCollisionObject"],
          "is_optional": "False"
        },
        {
          "name": "position",
          "doc": "finite world position in Defold units",
          "types": ["vector3"],
          "is_optional": "False"
        },
        {
          "name": "rotation",
          "doc": "finite, non-zero world rotation; normalized by the binding",
          "types": ["quaternion"],
          "is_optional": "False"
        }
      ],
      "examples": "Move a collision object while preserving its rotation:\n<div class=\"codehilite\"><pre><span></span><code><span class=\"kr\">function</span> <span class=\"nf\">init</span><span class=\"p\">(</span><span class=\"n\">self</span><span class=\"p\">)</span>\n    <span class=\"kd\">local</span> <span class=\"n\">object</span> <span class=\"o\">=</span> <span class=\"n\">bullet3d</span><span class=\"p\">.</span><span class=\"n\">get_collision_object</span><span class=\"p\">(</span><span class=\"s2\">&quot;#collisionobject&quot;</span><span class=\"p\">)</span>\n    <span class=\"kd\">local</span> <span class=\"n\">position</span><span class=\"p\">,</span> <span class=\"n\">rotation</span> <span class=\"o\">=</span> <span class=\"n\">bullet3d</span><span class=\"p\">.</span><span class=\"n\">collision_object</span><span class=\"p\">.</span><span class=\"n\">get_world_transform</span><span class=\"p\">(</span><span class=\"n\">object</span><span class=\"p\">)</span>\n    <span class=\"n\">bullet3d</span><span class=\"p\">.</span><span class=\"n\">collision_object</span><span class=\"p\">.</span><span class=\"n\">set_world_transform</span><span class=\"p\">(</span>\n        <span class=\"n\">object</span><span class=\"p\">,</span>\n        <span class=\"n\">position</span> <span class=\"o\">+</span> <span class=\"n\">vmath</span><span class=\"p\">.</span><span class=\"n\">vector3</span><span class=\"p\">(</span><span class=\"mi\">0</span><span class=\"p\">,</span> <span class=\"mi\">5</span><span class=\"p\">,</span> <span class=\"mi\">0</span><span class=\"p\">),</span>\n        <span class=\"n\">rotation</span><span class=\"p\">)</span>\n    <span class=\"n\">bullet3d</span><span class=\"p\">.</span><span class=\"n\">collision_object</span><span class=\"p\">.</span><span class=\"n\">activate</span><span class=\"p\">(</span><span class=\"n\">object</span><span class=\"p\">,</span> <span class=\"kc\">true</span><span class=\"p\">)</span>\n<span class=\"kr\">end</span>\n</code></pre></div>",
      "replaces": "",
      "error": "",
      "tparams": [],
      "members": [],
      "notes": [],
      "language": ""
    },
