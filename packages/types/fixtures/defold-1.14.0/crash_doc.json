    {
      "type": "TYPEDEF",
      "name": "crash.USERFIELD",
      "brief": "User crash-field slot index",
      "description": "An integer index identifying one of the 32 user-defined fields stored in a\ncrash dump. Valid indices are 0 through 31. Each field stores a string of at\nmost <code>crash.USERFIELD_SIZE</code> bytes; longer strings are truncated.",
      "returnvalues": [],
      "parameters": [
        {
          "name": "value",
          "doc": "zero-based user-field index",
          "types": ["integer"],
          "is_optional": "False"
        }
      ],
      "examples": "<div class=\"codehilite\"><pre><span></span><code><span class=\"n\">crash</span><span class=\"p\">.</span><span class=\"n\">set_user_field</span><span class=\"p\">(</span><span class=\"mi\">0</span><span class=\"p\">,</span> <span class=\"s2\">&quot;level=forest&quot;</span><span class=\"p\">)</span>\n<span class=\"n\">crash</span><span class=\"p\">.</span><span class=\"n\">set_user_field</span><span class=\"p\">(</span><span class=\"mi\">1</span><span class=\"p\">,</span> <span class=\"s2\">&quot;checkpoint=3&quot;</span><span class=\"p\">)</span>\n</code></pre></div>",
