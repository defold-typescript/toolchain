{
  "name": "@defold-typescript/types",
  "version": "0.0.0",
  "description": "TypeScript types for the Defold engine's Lua APIs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defold-typescript/toolchain.git",
    "directory": "packages/types"
  },
  "homepage": "https://github.com/defold-typescript/toolchain#readme",
  "bugs": "https://github.com/defold-typescript/toolchain/issues",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.ts"
    },
    "./script": {
      "types": "./generated/kinds/script.d.ts"
    },
    "./gui-script": {
      "types": "./generated/kinds/gui-script.d.ts"
    },
    "./render-script": {
      "types": "./generated/kinds/render-script.d.ts"
    },
    "./editor-script": {
      "types": "./generated/kinds/editor-script.d.ts"
    },
    "./api": {
      "types": "./src/index.ts"
    },
    "./core-types": {
      "types": "./src/core-types.ts"
    },
    "./lifecycle": {
      "types": "./src/lifecycle.ts"
    },
    "./editor": {
      "types": "./src/editor.ts"
    },
    "./timers": {
      "types": "./src/timers.d.ts"
    },
    "./hsm": {
      "types": "./hsm/index.d.ts"
    },
    "./hsm/async": {
      "types": "./hsm/async.d.ts"
    },
    "./hsm/debug": {
      "types": "./hsm/debug.d.ts"
    },
    "./hsm/defold": {
      "types": "./hsm/defold.d.ts"
    },
    "./api-availability.json": "./api-availability.json",
    "./api-signatures.json": "./api-signatures.json",
    "./url-parameters.json": "./url-parameters.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "generated",
    "hsm",
    "scripts",
    "api-targets.json",
    "api-migrations.json",
    "api-availability.json",
    "identity-vocabulary.json",
    "api-signatures.json",
    "url-parameters.json",
    "index.d.ts",
    "fixtures/messages_doc.json",
    "fixtures/defold-*",
    "!fixtures/defold-*/engine-bindings",
    "!fixtures/defold-*/annotations",
    "examples/translations.json",
    "!src/**/*.test.ts",
    "!scripts/**/*.test.ts",
    "!src/**/__snapshots__",
    "!scripts/lua-types-signature-index.ts",
    "!scripts/fidelity-audit.ts",
    "!scripts/augmentation-namespaces.ts",
    "!scripts/example-loose-types.ts",
    "!scripts/example-pins.ts",
    "!scripts/example-semantics.ts",
    "!scripts/example-surfaces.ts",
    "!scripts/example-typecheck.ts",
    "!scripts/example-variant-drift.ts",
    "!scripts/engine-binding-extract.ts",
    "!scripts/sync-engine-bindings.ts",
    "!scripts/engine-binding-diff.ts",
    "!scripts/engine-binding-verdicts.ts",
    "!scripts/engine-binding-verdicts.json",
    "!scripts/lua-kind.ts",
    "!scripts/index-slot-scan.ts",
    "!scripts/lua-annotations.ts",
    "!scripts/lua-annotation-diff.ts",
    "!scripts/lua-annotation-verdicts.ts",
    "!scripts/lua-annotation-verdicts.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "regen": "bun scripts/regen.ts",
    "generate-api-availability": "bun scripts/generate-api-availability.ts",
    "generate-api-signatures": "bun scripts/generate-api-signatures.ts --write",
    "import-defold-release": "bun scripts/import-defold-release.ts",
    "sync-api-docs": "bun scripts/sync-api-docs.ts",
    "sync-engine-bindings": "bun scripts/sync-engine-bindings.ts",
    "ref-doc-delta": "bun scripts/ref-doc-delta.ts --target defold-1.9.8 --namespace label --present label.get_text --absent label.set_text"
  },
  "dependencies": {
    "lua-types": "^2.13.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@typescript-to-lua/language-extensions": "1.19.0",
    "typescript": "6.0.2"
  }
}
