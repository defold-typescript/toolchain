{
  "name": "@defold-typescript/cli",
  "version": "0.0.0",
  "description": "End-user CLI for scaffolding and building Defold projects written in TypeScript.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defold-typescript/toolchain.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/defold-typescript/toolchain#readme",
  "bugs": "https://github.com/defold-typescript/toolchain/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "defold-typescript": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/__snapshots__"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/bin.ts --target=node --format=esm --packages=external --outdir=dist && tsc -p tsconfig.build.json --emitDeclarationOnly && bun run build:hsm-view-client",
    "build:hsm-view-client": "bun build client/main.tsx --target=browser --minify --define process.env.NODE_ENV='\"production\"' --outdir dist/hsm-view-client && tailwindcss -i client/styles.css -o dist/hsm-view-client/styles.css --minify",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client",
    "test": "bun test"
  },
  "dependencies": {
    "@defold-typescript/docs": "workspace:*",
    "@defold-typescript/library-types": "workspace:*",
    "@defold-typescript/transpiler": "workspace:*",
    "@defold-typescript/types": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@inquirer/prompts": "^7.0.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.2",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  }
}
