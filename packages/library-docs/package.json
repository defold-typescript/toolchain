{
  "name": "@defold-typescript/library-docs",
  "version": "0.0.0",
  "description": "Static documentation site for the libraries in packages/library-types/data.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build-model": "bun scripts/build-model.ts",
    "build-indexes": "bun scripts/build-search-index.ts && bun scripts/build-symbol-index.ts",
    "build": "bun run build-model && bun run build-indexes",
    "build:site": "bun run build && vite build --mode client && vite build",
    "dev": "bun run build && vite",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@defold-typescript/docs-render": "workspace:*",
    "@defold-typescript/types": "workspace:*",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/ubuntu": "^5.3.0",
    "@orama/orama": "^3.1.18",
    "@phosphor-icons/core": "^2.1.1",
    "@shikijs/markdown-it": "4.4.2",
    "@shikijs/transformers": "4.4.2",
    "comment-parser": "^1.4.8",
    "devicon": "^2.17.0",
    "hono": "^4.13.5",
    "honox": "^0.1.60",
    "markdown-it": "14.3.2",
    "markdown-it-footnote": "^4.0.0",
    "shiki": "4.4.2"
  },
  "devDependencies": {
    "@hono/vite-ssg": "^0.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.1",
    "@types/markdown-it": "14.1.2",
    "@types/markdown-it-footnote": "^3.0.4",
    "@typescript-to-lua/language-extensions": "1.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.2",
    "vite": "^8.2.1"
  }
}
