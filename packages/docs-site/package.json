{
  "name": "@defold-typescript/docs-site",
  "version": "0.0.0",
  "description": "Static documentation site for defold-typescript, rendering the guide to HTML.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build-indexes": "bun scripts/build-guide-images.ts && bun scripts/build-font-fallbacks.ts && bun scripts/build-changelog-dates.ts && bun scripts/build-search-index.ts && bun scripts/build-symbol-index.ts && bun scripts/build-llms.ts",
    "build-font-fallbacks": "bun scripts/build-font-fallbacks.ts",
    "build-llms": "bun scripts/build-llms.ts",
    "dev": "bun run build-indexes && vite",
    "build": "bun run build-indexes && vite build --mode client && vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@defold-typescript/types": "workspace:*",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/ubuntu": "^5.3.0",
    "@orama/orama": "^3.1.18",
    "@phosphor-icons/core": "^2.1.1",
    "@shikijs/markdown-it": "^4.4.2",
    "@shikijs/transformers": "^4.4.2",
    "comment-parser": "^1.4.8",
    "hono": "^4.13.1",
    "honox": "^0.1.60",
    "markdown-it": "^14.3.0",
    "shiki": "^4.4.2"
  },
  "devDependencies": {
    "@capsizecss/core": "^4.1.3",
    "@capsizecss/metrics": "^4.2.0",
    "@capsizecss/unpack": "^4.0.1",
    "@hono/vite-ssg": "^0.3.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1"
  }
}
